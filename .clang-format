---
Language:        Cpp

# Start from a conservative base
BasedOnStyle:    LLVM

# K&R braces
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterControlStatement: false
  AfterStruct: false
  AfterEnum: false
  AfterUnion: false
  BeforeElse: false
  BeforeCatch: false

RemoveBracesLLVM: true

# Traditional indentation
IndentWidth:     8
TabWidth:        8
UseTab:          Never
ContinuationIndentWidth: 8

# Keep things compact and horizontal
ColumnLimit:     78

# Function declarations/definitions
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: false
AlwaysBreakAfterReturnType: None
AlwaysBreakAfterDefinitionReturnType: None
IndentWrappedFunctionNames: false

# Pointer style: "char *p"
PointerAlignment: Right

# Old-school spacing
SpaceBeforeParens: ControlStatements
SpacesInParentheses: false
SpacesInSquareBrackets: false
SpaceInEmptyParentheses: false
SpacesInCStyleCastParentheses: false
AlignTrailingComments: false

# Macros
AlignConsecutiveMacros:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: true

# Consistent alignment
AlignConsecutiveDeclarations:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false

AlignConsecutiveAssignments:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false

# Keep includes untouched-ish
SortIncludes: false
IncludeBlocks: Preserve

# Don't get too clever
BinPackArguments: true
BinPackParameters: true

# Prefer compact old-C formatting
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false

# Switch formatting
IndentCaseLabels: false
IndentCaseBlocks: false

# Old-school initializer formatting
Cpp11BracedListStyle: false

# Avoid modern stylistic behaviors
BreakBeforeBinaryOperators: None
BreakConstructorInitializersBeforeComma: false
BreakStringLiterals: false

# Penalties tuned to avoid over-wrapping
PenaltyBreakBeforeFirstCallParameter: 1000
PenaltyBreakComment: 300
PenaltyBreakString: 1000
PenaltyExcessCharacter: 50

# Preserve manual formatting where possible
ReflowComments: false
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1

# Macros common in old C codebases
StatementMacros:
  - ASSERT
  - KASSERT
  - panic

# Preprocessor indentation
IndentPPDirectives: BeforeHash

...
